# Whitelist: this repo holds the shared source (nxrecomp/), the build entry, the docs and empty placeholder folders.
# Game data (ROMs, dumps, extracts, builds), keys, firmware, deps and tools never get committed.
/*
!/.gitignore
!/README.md
!/start.ps1
!/build.bat
!/CMakeLists.txt
!/CMakePresets.json
!/CLAUDE.md
!/.mcp.json

!/keys/
/keys/*
!/keys/.gitkeep
!/firmware/
/firmware/*
!/firmware/.gitkeep
!/deps/
/deps/*
!/deps/.gitkeep
!/.tools/
/.tools/*
!/.tools/.gitkeep

# mk8dx/ and pkmn-violet/ are the games' own repos (github.com/HelixNX/mk8dx, HelixNX/pkmn-violet), cloned here
# with .\start.ps1 clone; room/ and ldn-beacon/ are repos of their own too. All stay out of this one.

!/nxrecomp
