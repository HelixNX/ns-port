# Whitelist: this repo holds the source, the build entry, the docs and empty placeholder folders.
# Game data (ROMs, dumps, extracts, builds), keys, firmware, deps and tools never get committed.
/*
!/.gitignore
!/README.md
!/start.ps1
!/build.bat
!/CMakeLists.txt
!/CMakePresets.json
!/CLAUDE.md
!/.mcp.json

!/keys/
/keys/*
!/keys/.gitkeep
!/firmware/
/firmware/*
!/firmware/.gitkeep
!/deps/
/deps/*
!/deps/.gitkeep
!/.tools/
/.tools/*
!/.tools/.gitkeep

!/mk8dx/
/mk8dx/*
!/mk8dx/CLAUDE.md
!/mk8dx/rom/
/mk8dx/rom/*
!/mk8dx/rom/.gitkeep
!/mk8dx/mk8recomp

!/pkmn-violet/
/pkmn-violet/*
!/pkmn-violet/CLAUDE.md
!/pkmn-violet/NOTES.md
!/pkmn-violet/rom/
/pkmn-violet/rom/*
!/pkmn-violet/rom/.gitkeep
!/pkmn-violet/violetrecomp

!/nxrecomp
