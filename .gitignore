# Whitelist: this repo holds only the workspace docs and empty placeholder folders.
# Game data (ROMs, dumps, extracts, builds), keys, firmware, deps and tools never get committed.
/*
!/.gitignore
!/README.md
!/start.ps1
!/CLAUDE.md
!/.mcp.json

!/keys/
/keys/*
!/keys/.gitkeep
!/firmware/
/firmware/*
!/firmware/.gitkeep
!/deps/
/deps/*
!/deps/.gitkeep
!/.tools/
/.tools/*
!/.tools/.gitkeep

!/mk8dx/
/mk8dx/*
!/mk8dx/CLAUDE.md
!/mk8dx/rom/
/mk8dx/rom/*
!/mk8dx/rom/.gitkeep
!/mk8dx/mk8recomp

!/pokemon-violet/
/pokemon-violet/*
!/pokemon-violet/CLAUDE.md
!/pokemon-violet/NOTES.md
!/pokemon-violet/rom/
/pokemon-violet/rom/*
!/pokemon-violet/rom/.gitkeep
!/pokemon-violet/violetrecomp

!/nxrecomp
